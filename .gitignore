# Logs, process dumps and runtime data
logs/
*.log
*.pid
*.hprof
hs_err_pid*
replay_pid*
LOG_FILE_PATH_IS_UNDEFINED/
LOG_FILE_NAME_IS_UNDEFINED/
.deployed-image-tag

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.aws/
.ssh/
**/src/main/resources/**/application-local.yml
**/src/main/resources/**/application-local.yaml
**/src/main/resources/**/application-dev.yml
**/src/main/resources/**/application-dev.yaml

# Database backups (versioned schema/migration SQL remains tracked)
*.sql.gz
*.sql.zip
*.dump
/backups/

# npm is the single frontend package manager
/toadyReactWeb/yarn.lock

# Unused legacy fonts: keep local copies, exclude from the public repository
/toadyReactWeb/src/resources/MaruBuriTTF/
/toadyReactWeb/src/resources/nanum-barun-pen/
/toadyReactWeb/src/resources/nanum-gothic/

# Keep one README at the repository root and each application root only.
[Rr][Ee][Aa][Dd][Mm][Ee]*
!/README.md
!/toadyReactWeb/README.md
!/toadyWebApi/README.md
!/toadyScheduler/README.md

# Local notes consolidated into the root README
/docs/REFACTORING.md
/docs/REPOSITORY.md
