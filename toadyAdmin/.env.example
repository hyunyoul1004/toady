# 운영 DB의 관리자 전용 계정(database.sql 19번). 읽기와 회원 잠금·댓글 숨김만 허용한다.
DB_URL=jdbc:mariadb://localhost:3306/toady
DB_USERNAME=toady_admin
DB_PASSWORD=

# 관리자 로그인 계정. 비밀번호는 12자 이상(UTF-8 72바이트 이하)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS 프록시 뒤에서 공개할 때 true; HTTP 로컬 접속은 false
ADMIN_SECURE_COOKIE=false

# 수집 실행·일정 변경을 맡는 스케줄러 내부 API. 토큰은 스케줄러의 SCHEDULER_INTERNAL_TOKEN과 같은 값(32자 이상)
SCHEDULER_BASE_URL=http://localhost:8082
SCHEDULER_INTERNAL_TOKEN=
