DB_URL=jdbc:mariadb://localhost:3306/your_database
DB_USERNAME=your_username
DB_PASSWORD=replace-with-your-password
APPLYHOME_API_KEY=replace-with-your-applyhome-api-key

# Asia/Seoul; 운영 정책이며 API 공개 보장 시각은 아닙니다.
APPLYHOME_SYNC_CRON="0 15 3 * * *"
APPLYHOME_COMPETITION_CRON="0 15 4,20 * * *"
APPLYHOME_LOOKBACK_DAYS=90

# 관리 테이블(database.sql)을 준비한 뒤에만 활성화하세요. 켜면 관리자 사이트(toadyAdmin)가 내부 API로 수집을 관리합니다.
SCHEDULER_ADMIN_ENABLED=false
# 관리자 사이트(toadyAdmin)와 같은 값으로 둡니다. 32자 이상 무작위 값(예: openssl rand -base64 48)
SCHEDULER_INTERNAL_TOKEN=
