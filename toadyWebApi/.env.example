DB_URL=jdbc:mariadb://localhost:3306/toady
DB_USERNAME=your-db-user
DB_PASSWORD=replace-with-your-password
# Generate a single-line signing key: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace-with-your-base64-secret
SERVER_PORT=8081
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# database.sql 8,9번을 적용한 뒤 Gmail 일정 알림 활성화
PLANNER_REMINDERS_ENABLED=false
# 모든 인증/알림 메일을 합친 최근 24시간 발송 시도 제한
GMAIL_ROLLING_LIMIT=400
# 알림이 모두 사용하지 못하도록 인증용 용량 확보
GMAIL_AUTH_RESERVE=100

# 국토교통부 아파트 매매 실거래가 API 일반 또는 인코딩 인증키 (서버 전용)
MOLIT_TRADE_SERVICE_KEY=

# 웹 푸시 알림(database.sql 13~15번 적용 후). 키 생성: npx web-push generate-vapid-keys
# 비공개 키는 서버 .env.prod에만 두고 저장소에 올리지 않는다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스에 알릴 연락처(mailto: 또는 https: 주소)
WEB_PUSH_SUBJECT=
# 하루 1회 묶음 알림 발송
PUSH_DIGEST_ENABLED=false

# 카카오 로컬 REST API 키(서버 전용, 지도용 JavaScript 키와 다름). 넣으면 공고별 주변 시세 비교를 매일 미리 계산해
# 맞춤 청약·줍줍 목록 뱃지, 나의 청약 비교표, 공개 페이지, 줍줍 알림에 보여준다. database.sql 18번이 필요하다.
KAKAO_REST_API_KEY=
