DB_URL=jdbc:mariadb://localhost:3306/toady
DB_USERNAME=your-db-user
DB_PASSWORD=replace-with-your-password
# Generate a single-line signing key: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace-with-your-base64-secret
SERVER_PORT=8081
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람(선택). 비우면 MAIL_USERNAME. 메일 발송 서비스로 옮길 때 확인된 발신 주소를 넣는다.
MAIL_FROM=
MAIL_FROM_NAME=TOADY

# database.sql 8,9번을 적용한 뒤 Gmail 일정 알림 활성화
PLANNER_REMINDERS_ENABLED=false
# 모든 인증/알림 메일을 합친 최근 24시간 발송 시도 제한
GMAIL_ROLLING_LIMIT=400
# 알림이 모두 사용하지 못하도록 인증용 용량 확보
GMAIL_AUTH_RESERVE=100

# 국토교통부 아파트 매매 실거래가 API 일반 또는 인코딩 인증키 (서버 전용)
MOLIT_TRADE_SERVICE_KEY=

# 웹 푸시 알림(database.sql 13~15번 적용 후). 키 생성: npx web-push generate-vapid-keys
# 비공개 키는 서버 .env.prod에만 두고 저장소에 올리지 않는다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스에 알릴 연락처(mailto: 또는 https: 주소)
WEB_PUSH_SUBJECT=
# 하루 1회 묶음 알림 발송
PUSH_DIGEST_ENABLED=false

# 카카오 로컬 REST API 키(서버 전용, 지도용 JavaScript 키와 다름). 넣으면 공고별 주변 시세 비교를 매일 미리 계산해
# 맞춤 청약·줍줍 목록 뱃지, 나의 청약 비교표, 공개 페이지, 줍줍 알림에 보여준다. database.sql 18번이 필요하다.
KAKAO_REST_API_KEY=

# 쪽지 새 대화 시작 조건(기본: 끔). 악용이 보이면 켠다. 예) DM_MIN_ACCOUNT_HOURS=24, DM_REQUIRE_STORY=true
DM_MIN_ACCOUNT_HOURS=0
DM_REQUIRE_STORY=false
# 하루에 새로 시작할 수 있는 대화 상대 수와 보낼 수 있는 쪽지 수
DM_DAILY_NEW_THREADS=5
DM_DAILY_MESSAGES=50
# 위 쪽지·메일·실거래 한도는 database.sql 27번 적용 후 관리자 사이트 '서비스 설정'에서 바꾸면 그 값이 우선한다(1분 안에 반영).

# 관리자 사이트가 부르는 내부 API(/internal/admin: 푸시 발송·인증 메일 다시 보내기·탈퇴 대행) 토큰. 관리자의 ADMIN_API_TOKEN과 같은 값(32자 이상, 예: openssl rand -hex 32). 비우면 끈다.
ADMIN_API_TOKEN=

# 요청 제한·외부 API 결과 캐시용 Redis. 운영은 compose가 REDIS_HOST=redis를 넣고, 비밀번호만 여기 둔다(Redis 컨테이너도 이 값을 읽는다).
# 16자 이상(예: openssl rand -hex 32). 로컬은 비워 두면 메모리로 동작한다.
REDIS_PASSWORD=
